#!/bin/sh
#
# linemark [-L fmt] [-c leader] -- insert source-location comments
# into code chunks, so that the output of notangle (without -L!) can
# be mapped back to the .nw source by nolinemap.  See nolinemap.nw.
#
# sample usage:
#   notangle -filter linemark foo.nw > foo.py

fmt=
leader='#'
while [ $# -gt 0 ]
do
  case "$1" in
    -L)   [ $# -ge 2 ] ||
            { echo "linemark: option -L needs an argument" 1>&2; exit 1; }
          fmt="$2"; shift 2 ;;
    -L?*) fmt="${1#-L}"; shift ;;
    -c)   [ $# -ge 2 ] ||
            { echo "linemark: option -c needs an argument" 1>&2; exit 1; }
          leader="$2"; shift 2 ;;
    -c?*) leader="${1#-c}"; shift ;;
    --)   shift; break ;;
    -*)   echo "linemark: unknown option $1" 1>&2; exit 1 ;;
    *)    break ;;
  esac
done
[ -n "$fmt" ] || fmt="$leader"' %L "%F"'
AWK="${AWK-nawk}"
command -v "$AWK" >/dev/null 2>&1 || AWK=awk
LINEMARK_FMT="$fmt" "$AWK" '
BEGIN { fmt = ENVIRON["LINEMARK_FMT"]; lineno = 1 }
function marker(    out, i, c) {
  out = ""
  for (i = 1; i <= length(fmt); i++) {
    c = substr(fmt, i, 1)
    if (c == "%" && i < length(fmt)) {
      i++; c = substr(fmt, i, 1)
      if (c == "L")      out = out lineno
      else if (c == "F") out = out file
      else if (c == "%") out = out "%"
      else               out = out "%" c
    } else out = out c
  }
  print "@text " out
  print "@nl"
  pending = 0
}
/^@file /       { file = substr($0, 7); lineno = 1; print; next }
/^@line /       { lineno = $2 + 0; print; next }
/^@begin code / { code = 1; print; next }
/^@end code /   { code = 0; afterdefn = 0; sawuse = 0; pending = 0
                  print; next }
/^@defn /       { afterdefn = 1; print; next }
/^@use /        { if (code && pending) marker()
                  if (code) sawuse = 1; print; next }
/^(@nl|@index nl)$/ {
  if (code && pending) marker()
  print
  lineno++
  if (code && (afterdefn || sawuse)) { pending = 1; afterdefn = 0; sawuse = 0 }
  next
}
/^@text /       { if (code && pending) marker(); print; next }
{ print }
' "$@"
