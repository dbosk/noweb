Reads a noweb markup stream on stdin and writes it to stdout,
adding an ``@language`` line to every code chunk whose language
can be determined from filename-like chunk names, transitively
through chunk uses.  Run it as the first filter, before any
filter that consumes language information (e.g. the autodefs
filters).  See nowebfilters(7).
"""

import sys

<<inference constants>>
<<inference functions>>
<<autolang functions>>

if __name__ == "__main__":
    autolang_main()
